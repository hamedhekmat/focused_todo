{
  "manifest_version": 3,
  "name": "Todo Blocker",
  "version": "1.0",
  "description": "A Chrome extension that blocks URLs until you complete your todo list",

  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "Focused Todo"
  },
  "permissions": ["activeTab", "storage", "tabs", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ],
  "declarativeNetRequest": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}