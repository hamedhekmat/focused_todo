{
  "manifest_version": 3,
  "name": "Focused Todo",
  "version": "1.0.0",
  "description": "A todo list extension that helps you focus by blocking distracting websites",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Focused Todo"
  }
}

